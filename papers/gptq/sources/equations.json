  "3": "<table class=\"ltx_equation ltx_eqn_table\" id=\"S3.E3\">\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math alttext=\"\\mathbf{H}_{-q}^{-1}=\\Big(\\mathbf{H}^{-1}-\\frac{1}{[\\mathbf{H}^{-1}]_{qq}}\\mathbf{H}^{-1}_{:,q}\\mathbf{H}^{-1}_{q,:}\\Big)_{-p}.\" class=\"ltx_math_unparsed\" display=\"block\" id=\"S3.E3.m1\" intent=\":literal\"><semantics><mrow><msubsup><mi>𝐇</mi><mrow><mo>−</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><msub><mrow><mo maxsize=\"1.600em\" minsize=\"1.600em\">(</mo><msup><mi>𝐇</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mfrac><mn>1</mn><msub><mrow><mo stretchy=\"false\">[</mo><msup><mi>𝐇</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy=\"false\">]</mo></mrow><mrow><mi>q</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>q</mi></mrow></msub></mfrac><msubsup><mi>𝐇</mi><mrow><mo rspace=\"0em\">:</mo><mo>,</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>𝐇</mi><mrow><mi>q</mi><mo>,</mo><mo>:</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo maxsize=\"1.600em\" minsize=\"1.600em\">)</mo></mrow><mrow><mo>−</mo><mi>p</mi></mrow></msub><mo lspace=\"0em\">.</mo></mrow><annotation encoding=\"application/x-tex\">\\mathbf{H}_{-q}^{-1}=\\Big(\\mathbf{H}^{-1}-\\frac{1}{[\\mathbf{H}^{-1}]_{qq}}\\mathbf{H}^{-1}_{:,q}\\mathbf{H}^{-1}_{q,:}\\Big)_{-p}.</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\" rowspan=\"1\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(3)</span></td></tr></tbody>\n</table>",
