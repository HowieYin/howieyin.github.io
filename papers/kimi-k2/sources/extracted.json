    "1": {
      "latex": "\\mathbf{Q}^{h} = \\mathbf X \\mathbf W_q^{h}, \\quad\n\\mathbf K^{h} = \\mathbf X \\mathbf W_k^{h}, \\quad\n\\mathbf V^{h} = \\mathbf X \\mathbf W_v^{h}.",
