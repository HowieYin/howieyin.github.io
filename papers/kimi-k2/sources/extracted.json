      "label": "unnumbered"
    },
    "3": {
      "latex": "S_{\\max}^{h} = \\frac{1}{\\sqrt{d}} \\max_{\\mathbf X \\in B} \\max_{i,j} \\mathbf Q_i^{h} \\mathbf K_j^{h\\top}",
      "label": "unnumbered"
    },
    "4": {
      "latex": "\\mathbf W_q^{h} \\gets \\gamma^{\\alpha} \\mathbf  W_q^{h} \\qquad\n  \\mathbf W_k^{h} \\gets  \\gamma^{1-\\alpha} \\mathbf W_k^{h}",
      "label": "unnumbered"
    },
    "5": {
      "latex": "\\begin{aligned}L_{\\mathrm{RL}}(\\theta) = \\mathbb{E}_{x \\sim\\mathcal{D}}\\left[ \\frac{1}{K} \\sum_{i=1}^K \\left[  \\left( r(x, y_i) - \\bar{r}(x)- \\tau \\log \\frac{\\pi_\\theta(y_i | x)}{{\\pi}_{\\mathrm{old}}(y_i | x)} \\right)^2 \\right]\\right] \\, ,\\end{aligned}",
      "label": "unnumbered"
    },
    "6": {
      "latex": "S_{\\max} = \\max_{i,j} \\bigl(q_i^{\\vphantom{\\top}}\\! \\cdot k_j\\bigr)",
