    "9": {
      "latex": "\\begin{aligned}\\Delta\\mathbf W_t &= \\sum_j \\bar\\sigma\\,\\bar u_j \\bar v_j^{\\top}\\end{aligned}",
      "label": "4"
    },
    "10": {
      "latex": "\\begin{aligned}\\mathbf W_t \\leftarrow \\sum_i \\sigma_i u_i v_i^{\\top} + \\sum_j \\bar\\sigma\\,\\bar u_j \\bar v_j^{\\top}\\end{aligned}",
      "label": "5"
    },
